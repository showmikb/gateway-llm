{
  "name": "@gateway-llm/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript/Node SDK for Gateway-LLM — the LLM control plane.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./langchain": {
      "import": "./dist/langchain.js",
      "types": "./dist/langchain.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "openai": "^4.70.0"
  },
  "peerDependencies": {
    "@noble/ed25519": "^2.1.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "@types/node": "^20.11.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/gateway-llm/gateway-llm.git",
    "directory": "sdks/typescript"
  },
  "keywords": ["llm", "openai", "gateway", "smart-routing", "observability"]
}
