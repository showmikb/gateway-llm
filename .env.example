# Gateway-LLM - Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ──────────────────────────────────────────────
# Master key for admin UI and management API
# Change this before deploying!
# ──────────────────────────────────────────────
GATEWAY_LLM_MASTER_KEY=sk-master-change-me

# ──────────────────────────────────────────────
# Encryption key for provider credentials stored in DB
# If not set, GATEWAY_LLM_MASTER_KEY is used as fallback
# ──────────────────────────────────────────────
GATEWAY_LLM_ENCRYPTION_KEY=

# ──────────────────────────────────────────────
# Provider API keys (legacy env-based, optional if using
# the Credentials page in the UI to store keys in DB)
# ──────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ──────────────────────────────────────────────
# Infrastructure (defaults work with docker-compose)
# ──────────────────────────────────────────────
DATABASE_URL=postgres://gatewayllm:gatewayllm@db:5432/gatewayllm?sslmode=disable
REDIS_URL=redis://redis:6379

# ──────────────────────────────────────────────
# Public URL the browser uses to reach the backend API.
# Baked into the Next.js build at UI image build time.
# In production, this is the HTTPS subdomain terminated by Caddy.
# For local dev without TLS, use http://localhost:8080
# ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.gateway-llm.com
