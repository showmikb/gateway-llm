{
  "annotations": { "list": [] },
  "description": "Gateway-LLM Smart Routing Moat — savings, quality, retries, top aliases. Drop-in dashboard that scrapes the gateway's /metrics endpoint.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "title": "Gateway-LLM — Smart Routing Moat",
  "uid": "gatewayllm-savings",
  "version": 1,
  "schemaVersion": 39,
  "tags": ["gateway-llm", "llm", "savings"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      },
      {
        "name": "alias",
        "type": "query",
        "datasource": "$datasource",
        "query": "label_values(gatewayllm_moat_requests_total, alias)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "org_id",
        "type": "query",
        "datasource": "$datasource",
        "query": "label_values(gatewayllm_moat_requests_total, org_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "panels": [
    {
      "type": "stat",
      "title": "Total $ saved (window)",
      "datasource": "$datasource",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "decimals": 2, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }] } }
      },
      "targets": [{ "expr": "sum(increase(gatewayllm_moat_savings_usd_total{alias=~\"$alias\", org_id=~\"$org_id\"}[$__range]))", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Requests routed",
      "datasource": "$datasource",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "sum(increase(gatewayllm_moat_routing_decisions_total{decision=\"overridden\"}[$__range]))", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Quality pass %",
      "datasource": "$datasource",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [{ "expr": "sum(increase(gatewayllm_moat_judge_passes_total{result=\"pass\"}[$__range])) / clamp_min(sum(increase(gatewayllm_moat_judge_passes_total[$__range])), 1)", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Retry rate",
      "datasource": "$datasource",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [{ "expr": "sum(increase(gatewayllm_moat_routing_decisions_total{decision=\"retried\"}[$__range])) / clamp_min(sum(increase(gatewayllm_moat_requests_total[$__range])), 1)", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "$ saved over time (per alias)",
      "datasource": "$datasource",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } },
      "targets": [{ "expr": "sum by (alias) (rate(gatewayllm_moat_savings_usd_total{alias=~\"$alias\", org_id=~\"$org_id\"}[5m]))", "legendFormat": "{{alias}}", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Baseline vs Actual cost USD/s",
      "datasource": "$datasource",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } },
      "targets": [
        { "expr": "sum(rate(gatewayllm_moat_baseline_cost_usd_total{alias=~\"$alias\", org_id=~\"$org_id\"}[5m]))", "legendFormat": "baseline", "refId": "A" },
        { "expr": "sum(rate(gatewayllm_moat_cost_usd_total{alias=~\"$alias\", org_id=~\"$org_id\"}[5m]))", "legendFormat": "actual", "refId": "B" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency P95 by served alias",
      "datasource": "$datasource",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (model, le) (rate(gatewayllm_request_duration_seconds_bucket[5m])))", "legendFormat": "{{model}}", "refId": "A" }]
    },
    {
      "type": "barchart",
      "title": "Top aliases by savings",
      "datasource": "$datasource",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } },
      "targets": [{ "expr": "topk(10, sum by (alias) (increase(gatewayllm_moat_savings_usd_total[$__range])))", "legendFormat": "{{alias}}", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Quality score distribution (P50 / P95)",
      "datasource": "$datasource",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (alias, le) (rate(gatewayllm_moat_quality_score_bucket{alias=~\"$alias\"}[5m])))", "legendFormat": "{{alias}} P50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (alias, le) (rate(gatewayllm_moat_quality_score_bucket{alias=~\"$alias\"}[5m])))", "legendFormat": "{{alias}} P95", "refId": "B" }
      ]
    }
  ]
}
